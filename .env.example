# --- Data DB (read/write — used by the pipeline) ---
DB_USER=...
DB_PASSWORD=...
DB_HOST=localhost
DB_PORT=5433
DB_NAME=...

# --- Read-only role (used by the agent's SQL tool; no write grants) ---
RO_DB_USER=...
RO_DB_PASSWORD=...

# --- LLM ---
OPENAI_API_KEY=...

# --- Observability (optional) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=job-market-analyzer

# --- Airflow ---
# FERNET_KEY: generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=...
# AIRFLOW_UID: on Linux/macOS run `id -u`; defaults to 50000 if unset
AIRFLOW_UID=...